# API Base URL Configuration
# Copy this file to .env and configure for your environment

# For local development (same computer):
VITE_API_BASE=http://localhost:8000/api

# For LAN access (different computers on same WiFi):
# Replace YOUR_IP with your backend server's IP address
# Example: VITE_API_BASE=http://192.168.1.100:8000/api
# VITE_API_BASE=http://YOUR_IP:8000/api

